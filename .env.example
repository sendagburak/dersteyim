# Okul modu: internet sunucusu gerekmez; yalnızca bu okulun yerel verileri tutulur.
APP_MODE=school
HOST=127.0.0.1
PORT=5000
NODE_ENV=production
TRUST_PROXY=0
REQUIRE_DEVICE_APPROVAL=false
# Okul modunda aşağıdaki değerler true yapılsa bile gönderim kapalıdır.
EMAIL_ENABLED=false
PUSH_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# DATA_DIR değiştirilecekse veritabanı ve anahtarlar birlikte taşınmalıdır.
